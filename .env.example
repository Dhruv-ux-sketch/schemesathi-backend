# Which LLM provider to use for FINAL ANSWER GENERATION only.
# Retrieval/embeddings run locally and need no key.
# Options: "openai" | "anthropic" | "none" (none = return raw retrieved chunks, no generation)
LLM_PROVIDER=none

# Fill in ONE of these once you decide on a provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names (defaults are fine to start)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local embedding model (downloaded automatically on first run, free, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma persistent storage location
CHROMA_DIR=./data/chroma_db
CHROMA_COLLECTION=government_schemes

# CORS - your frontend URL(s), comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Default: local SQLite file, zero setup needed for development.
# For deployment, get a free connection string from neon.tech (no credit card)
# and it'll look like: postgresql://user:pass@ep-xxx.neon.tech/dbname
DATABASE_URL=sqlite:///./data/schemesathi.db

# Auth - IMPORTANT: generate a real random secret before deploying.
# You can generate one by running: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# The account with this email gets access to the Admin panel (upload/delete
# scheme documents). Set this to the email you'll sign up with.
ADMIN_EMAIL=
